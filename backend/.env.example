# Copy this file to .env and adjust values as needed.
PORT=3000

# MongoDB container bootstrap credentials (local development defaults only).
# Use strong secrets and never reuse these values outside local development.
MONGO_INITDB_ROOT_USERNAME=admin_user
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-password
MONGO_INITDB_DATABASE=FlashWhizz_DB

# App connection string for Docker Compose (app container -> mongodb service)
# Keep username/password in this URI aligned with MONGO_INITDB_ROOT_* above.
MONGODB_URI=mongodb://admin_user:replace-with-strong-password@mongodb:27017/FlashWhizz_DB?authSource=admin